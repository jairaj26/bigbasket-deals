# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID or Channel Username (e.g. 123456789 or @my_deals_channel)
# You can find your Chat ID by messaging @userinfobot (https://t.me/userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Default 6-digit delivery pincode for deal searching
PINCODE=560001

# Minimum discount percentage to filter deals (User requested >= 70%)
MIN_DISCOUNT=70

# Max pages to scan per category (2 pages is usually ~80-100 top deals sorted by discount)
MAX_PAGES_PER_CATEGORY=2

# Exclude out-of-stock items (true/false)
EXCLUDE_OUT_OF_STOCK=true

# Hours before an item can be re-alerted if it remains on deal (prevents spam)
COOLDOWN_HOURS=48
